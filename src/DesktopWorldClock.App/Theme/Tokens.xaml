<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Single source of truth for every visual value. Change the look here, not in views. -->

    <Color x:Key="Color.Text.Primary">#F5F7FA</Color>
    <Color x:Key="Color.Text.Secondary">#B3FFFFFF</Color>
    <Color x:Key="Color.Text.Tertiary">#7AFFFFFF</Color>
    <Color x:Key="Color.Accent">#7C8CFF</Color>

    <Color x:Key="Color.Glass.Tint">#59141620</Color>
    <Color x:Key="Color.Glass.TintOpaque">#F2181A22</Color>
    <Color x:Key="Color.Glass.SheenTop">#30FFFFFF</Color>
    <Color x:Key="Color.Glass.SheenFade">#00FFFFFF</Color>
    <Color x:Key="Color.Glass.EdgeBright">#80FFFFFF</Color>
    <Color x:Key="Color.Glass.EdgeDim">#14FFFFFF</Color>
    <Color x:Key="Color.Glass.EdgeRim">#40FFFFFF</Color>

    <Color x:Key="Color.Surface.Menu">#F21C1E26</Color>
    <Color x:Key="Color.Surface.Input">#14FFFFFF</Color>
    <Color x:Key="Color.Border.Subtle">#1FFFFFFF</Color>
    <Color x:Key="Color.State.Hover">#14FFFFFF</Color>
    <Color x:Key="Color.State.Selected">#407C8CFF</Color>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Glass.Fill" Color="{StaticResource Color.Glass.Tint}" />
    <SolidColorBrush x:Key="Brush.Glass.FillOpaque" Color="{StaticResource Color.Glass.TintOpaque}" />
    <SolidColorBrush x:Key="Brush.Surface.Menu" Color="{StaticResource Color.Surface.Menu}" />
    <SolidColorBrush x:Key="Brush.Surface.Input" Color="{StaticResource Color.Surface.Input}" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.State.Hover" Color="{StaticResource Color.State.Hover}" />
    <SolidColorBrush x:Key="Brush.State.Selected" Color="{StaticResource Color.State.Selected}" />

    <!-- Top-down specular sheen, like light hitting the upper half of a glass slab. -->
    <LinearGradientBrush x:Key="Brush.Glass.Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Glass.SheenTop}" />
        <GradientStop Offset="0.55" Color="{StaticResource Color.Glass.SheenFade}" />
    </LinearGradientBrush>

    <!-- Bright top-left edge fading out, with a faint rim returning at bottom-right (refraction). -->
    <LinearGradientBrush x:Key="Brush.Glass.Edge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Glass.EdgeBright}" />
        <GradientStop Offset="0.4" Color="{StaticResource Color.Glass.EdgeDim}" />
        <GradientStop Offset="0.7" Color="{StaticResource Color.Glass.EdgeDim}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Glass.EdgeRim}" />
    </LinearGradientBrush>

    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSize.Time">64</sys:Double>
    <sys:Double x:Key="FontSize.Title">15</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>

    <sys:Double x:Key="Size.ClockMinWidth">248</sys:Double>
    <sys:Double x:Key="Size.PickerWidth">340</sys:Double>
    <sys:Double x:Key="Size.PickerHeight">440</sys:Double>
    <sys:Double x:Key="Size.CheckColumn">20</sys:Double>
    <sys:Double x:Key="Size.MenuMinWidth">168</sys:Double>

    <sys:Double x:Key="Radius.CardValue">24</sys:Double>
    <CornerRadius x:Key="Radius.Card">24</CornerRadius>
    <CornerRadius x:Key="Radius.Menu">12</CornerRadius>
    <CornerRadius x:Key="Radius.Item">8</CornerRadius>
    <CornerRadius x:Key="Radius.Input">10</CornerRadius>

    <Thickness x:Key="Padding.Card">22,18,24,18</Thickness>
    <Thickness x:Key="Padding.Menu">6</Thickness>
    <Thickness x:Key="Padding.MenuItem">10,7,14,7</Thickness>
    <Thickness x:Key="Padding.ListItem">12,9</Thickness>
    <Thickness x:Key="Padding.Input">12,9</Thickness>

    <Thickness x:Key="Spacing.TimeTop">0,-4,0,-6</Thickness>
    <Thickness x:Key="Spacing.InlineGap">8,0,0,0</Thickness>
    <Thickness x:Key="Spacing.StackGap">0,12,0,0</Thickness>
    <Thickness x:Key="Spacing.Separator">8,5</Thickness>
</ResourceDictionary>
