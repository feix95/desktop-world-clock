<Window x:Class="DesktopWorldClock.App.CityPicker.CityPickerWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择城市"
        Style="{StaticResource GlassWindow}"
        Width="{StaticResource Size.PickerWidth}"
        Height="{StaticResource Size.PickerHeight}"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <ContentControl Style="{StaticResource GlassCard}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Title}" Text="选择城市" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}"
                     Tag="搜索城市, 中文或英文" Margin="{StaticResource Spacing.StackGap}" />
            <ListBox x:Name="CityList" Style="{StaticResource CityList}" ItemContainerStyle="{StaticResource CityListItem}"
                     Margin="{StaticResource Spacing.StackGap}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding UtcOffset}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding NameZh}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding NameEn}"
                                           Margin="{StaticResource Spacing.InlineGap}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </ContentControl>
</Window>
